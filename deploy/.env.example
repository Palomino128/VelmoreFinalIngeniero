# ================================================================
#  VELMORE — Variables de entorno para PRODUCCIÓN
#  Archivo: deploy/.env.example
#
#  INSTRUCCIONES:
#  1. Copiar este archivo como ".env" (sin ".example")
#  2. Reemplazar TODOS los valores de ejemplo con los reales
#  3. NUNCA subir el archivo ".env" real al repositorio Git
#     (está incluido en .gitignore)
#  4. En Windows: cargar con  for /F "tokens=*" %%A in (.env) do SET %%A
#  5. En Linux:   cargar con  export $(cat .env | xargs)
# ================================================================

# ── Base de datos MySQL ─────────────────────────────────────────
# URL completa de conexión a MySQL en el servidor de producción
VELMORE_DB_URL=jdbc:mysql://localhost:3306/velmore_db?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true

# Usuario de MySQL (preferir usuario dedicado, no root)
VELMORE_DB_USER=velmore_user

# Contraseña del usuario MySQL
# REEMPLAZAR con una contraseña segura de al menos 16 caracteres
VELMORE_DB_PASS=CAMBIAR_CONTRASEÑA_AQUI

# ── Credenciales del administrador VELMORE ──────────────────────
# Usuario y contraseña para acceder al panel de administración
VELMORE_ADMIN_USER=admin
# REEMPLAZAR con una contraseña segura
VELMORE_ADMIN_PASS=CAMBIAR_CONTRASEÑA_ADMIN_AQUI

# ── WhatsApp Business ───────────────────────────────────────────
# Número de WhatsApp en formato internacional (sin + ni espacios)
# Ejemplo Perú: 51 seguido del número de 9 dígitos
VELMORE_WA_NUMERO=51999999999

# ── Servidor ────────────────────────────────────────────────────
# Puerto en el que escucha la aplicación
# Usar 80 si hay un proxy reverso (Nginx/Apache) en el servidor
SERVER_PORT=8080

# ── Ejemplo con valores de producción real ──────────────────────
# VELMORE_DB_URL=jdbc:mysql://mi-servidor-mysql.com:3306/velmore_prod?useSSL=true
# VELMORE_DB_USER=velmore_prod_user
# VELMORE_DB_PASS=MiContraseñaSegura2024!@#
# VELMORE_ADMIN_USER=admin_velmore
# VELMORE_ADMIN_PASS=AdminVelmore2024!@#$
# VELMORE_WA_NUMERO=51987654321
# SERVER_PORT=8080
